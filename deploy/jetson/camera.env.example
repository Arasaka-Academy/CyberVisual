CYBERVISUAL_HOST=0.0.0.0
CYBERVISUAL_PORT=8000
CYBERVISUAL_CONFIG=/etc/cybervisual/config.json
CYBERVISUAL_MODEL_PATH=/var/lib/cybervisual/models/model.engine
CYBERVISUAL_STATE_DIR=/var/lib/cybervisual/device
CYBERVISUAL_CAPTURE_DIR=/var/lib/cybervisual/captures
CYBERVISUAL_SOURCE=camera
CYBERVISUAL_DETECTOR=auto
CYBERVISUAL_CAMERA_INDEX=0
CYBERVISUAL_CAMERA_FOURCC=MJPG
CYBERVISUAL_CAMERA_FPS=30
